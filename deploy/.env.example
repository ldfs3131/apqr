# APQR · produção no VPS. Copie para /opt/oneup/apqr/.env e preencha.
# NUNCA envie este arquivo para o GitHub nem para chats. Guarde uma cópia num gerenciador de senhas.

# Versão em uso (nome da pasta releases/apqr-<versão>). Trocar aqui = atualizar ou voltar versão.
APQR_VERSION=2.3.0

# Endereço público (links de convite, de senha e do webhook do checkout)
APP_URL=https://mentoria.pollylyra.com.br

# Ambiente que abre na tela de entrada
DEFAULT_TENANT=pollyana-lyra

# Senhas do banco. Use SÓ letras e números (símbolos quebram a conexão). Gere com:  openssl rand -hex 24
# POSTGRES_ADMIN_PASSWORD: administrador do banco (backup/restauração). APQR_DB_PASSWORD: usuário limitado do app.
# Atenção: as duas só valem na PRIMEIRA subida do banco. Para trocar depois, veja BACKUP-E-RESTAURACAO.md.
POSTGRES_ADMIN_PASSWORD=
APQR_DB_PASSWORD=

# Primeiro administrador ONE UP (criado na primeira subida, se ainda não existir nenhum).
# Senha: 10+ caracteres com letras e números. Depois do primeiro acesso, pode apagar a senha daqui.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Lucas Davi

# Porta interna do APQR no servidor (só o proxy enxerga). Cada sistema da ONE UP usa uma porta diferente.
APQR_PORT=3000

# E-mail (opcional): avisos de compra e links. Ex.: smtps://usuario:senha@smtp.servidor.com:465
SMTP_URL=
MAIL_FROM=

# IA (opcional). Sem chave, os relatórios são montados por regras.
ANTHROPIC_API_KEY=
AI_MODEL=

# Backup fora do VPS (opcional, depois de configurar o rclone). Ex.: gdrive:backups/apqr
OFFSITE_REMOTE=
