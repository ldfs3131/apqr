# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# Banco (produção). Sem DATABASE_URL, o sistema usa o banco local embutido (PGlite) em ./data/pglite.
# DATABASE_URL=postgres://usuario:senha@host:5432/apqr
POSTGRES_PASSWORD=troque-esta-senha

# Endereço público do site (usado nos links de convite e de senha)
APP_URL=https://app.oneup.com.br

# Ambiente que abre na tela de entrada (identificador do ambiente da professora)
DEFAULT_TENANT=pollyana-lyra

# Atrás de proxy/HTTPS (Render, Railway, Cloudflare): 1
TRUST_PROXY=1

# Primeiro administrador ONE UP (criado só se ainda não existir nenhum)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador ONE UP

# E-mail (opcional). Sem SMTP, os links de senha são gerados pela professora na plataforma.
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
# MAIL_FROM="ONE UP <nao-responda@oneup.com.br>"

# IA (opcional). Sem chave, os relatórios são montados por regras.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
# AI_DAILY_LIMIT_PER_TENANT=100

# Arquivos enviados (materiais e logotipos)
# FILES_DIR=/data/files
