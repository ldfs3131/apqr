# ONE UP · Método APQR — modelo de configuração. Copie para ".env" e preencha. NUNCA envie o ".env" ao GitHub nem a chats.
#
# Este modelo é para rodar na sua máquina (desenvolvimento) ou em hospedagem simples.
# NO VPS (produção, Docker): o modelo é deploy/.env.example e o arquivo real fica em /opt/oneup/apqr/.env.

# Porta do servidor
PORT=3000

# Banco. Sem DATABASE_URL, usa um banco embutido (PGlite) na pasta PGLITE_DIR — bom para testes.
# Produção: DATABASE_URL=postgres://usuario:senha@servidor:5432/apqr  (use um usuário SEM superpoderes; a segurança por ambiente depende disso)
# DATABASE_URL=
# PGLITE_DIR=./data/pglite
# DATABASE_SSL=0            # 0 quando o banco está na mesma rede interna (Docker); padrão: SSL ligado para banco externo

# Pasta dos arquivos enviados (PDFs, logotipos)
# FILES_DIR=./data/files

# Endereço público (links de convite, de senha e do webhook do checkout)
# APP_URL=https://mentoria.seudominio.com.br

# Atrás de um proxy (Nginx/Caddy): 1
# TRUST_PROXY=1

# Primeiro administrador ONE UP (criado se ainda não existir nenhum). Senha: 10+ caracteres com letras e números.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador ONE UP

# Ambiente que abre na tela de entrada
# DEFAULT_TENANT=pollyana-lyra

# E-mail (opcional). Ex.: smtps://usuario:senha@smtp.servidor.com:465
# SMTP_URL=
# MAIL_FROM=

# IA (opcional). Sem chave, os relatórios são montados por regras.
# ANTHROPIC_API_KEY=
# AI_MODEL=

# Versão em execução, informada em /api/health (o VPS preenche sozinho a partir do arquivo VERSION)
# APP_VERSION=
